rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 200;
    }

    function isValidPatient(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 64 &&
             data.name is string && data.name.size() <= 200 &&
             data.provinceId is string && data.provinceId.size() <= 128 &&
             data.localityId is string && data.localityId.size() <= 128 &&
             data.healthPostId is string && data.healthPostId.size() <= 128 &&
             data.tbType is string && data.tbType.size() <= 64 &&
             data.status is string && data.status.size() <= 64;
    }

    function isValidProvince(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.code is string && data.code.size() <= 20 &&
             data.population is number && data.population >= 0;
    }

    function isValidLocality(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.provinceId is string && data.provinceId.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.population is number && data.population >= 0;
    }

    function isValidHealthPost(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.code is string && data.code.size() <= 64 &&
             data.provinceId is string && data.provinceId.size() <= 128 &&
             data.localityId is string && data.localityId.size() <= 128;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && incoming().id == userId && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && incoming().id == userId && incoming().id == existing().id && isValidUser(incoming());
      allow delete: if false;
    }

    // TB Patients collection
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(patientId) && incoming().id == patientId && isValidPatient(incoming());
      allow update: if isSignedIn() && isValidId(patientId) && incoming().id == patientId && incoming().id == existing().id && isValidPatient(incoming());
      allow delete: if isSignedIn() && isValidId(patientId);
    }

    // Provinces collection
    match /provinces/{provinceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(provinceId) && incoming().id == provinceId && isValidProvince(incoming());
      allow update: if isSignedIn() && isValidId(provinceId) && incoming().id == provinceId && incoming().id == existing().id && isValidProvince(incoming());
      allow delete: if isSignedIn() && isValidId(provinceId);
    }

    // Localities / Districts collection
    match /localities/{localityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(localityId) && incoming().id == localityId && isValidLocality(incoming());
      allow update: if isSignedIn() && isValidId(localityId) && incoming().id == localityId && incoming().id == existing().id && isValidLocality(incoming());
      allow delete: if isSignedIn() && isValidId(localityId);
    }

    // Health Posts collection
    match /healthPosts/{healthPostId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(healthPostId) && incoming().id == healthPostId && isValidHealthPost(incoming());
      allow update: if isSignedIn() && isValidId(healthPostId) && incoming().id == healthPostId && incoming().id == existing().id && isValidHealthPost(incoming());
      allow delete: if isSignedIn() && isValidId(healthPostId);
    }
  }
}
